# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# copied out of node_modules by scripts/copy-maplibre-worker.mjs on every
# dev/build run, so committing it would only let it go stale
/public/maplibre/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# a local runtime configuration, which is one deployment's and not the
# repository's. config.example.json is the committed one, and it ships its
# analytics fields blank so a fork never inherits somebody else's website id.
/config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json

# editors and os
.idea/
.vscode/
Thumbs.db
*.swp
*.tmp
